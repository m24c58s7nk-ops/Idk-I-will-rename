@page "/"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="game-shell">
    <canvas id="gravityCanvas" tabindex="0"></canvas>
</div>

@code {
    private IJSObjectReference? module;
    private DotNetObjectReference<Index>? self;
    private readonly GravityGame game = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gravity.js?v=2");
        self = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("startGravity", "gravityCanvas", self);
    }

    [JSInvokable]
    public GravityState Tick(float move, bool jump)
    {
        game.Update(move, jump);
        return game.State;
    }

    public async ValueTask DisposeAsync()
    {
        self?.Dispose();
        if (module is not null) await module.DisposeAsync();
    }
}
